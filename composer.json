{
    "name": "softspring/doctrine-target-entity-resolver",
    "description": "This package provides a class that helps resolve target entities",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.2",
        "symfony/dependency-injection": "^6.4|^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\Component\\DoctrineTargetEntityResolver\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
